# ── Server ───────────────────────────────────────────────────────────────────
ENV=local                 # local | ci | staging | prod
PORT=8080
BASE_URL=http://localhost:8080
LOG_LEVEL=info            # debug | info | warn | error
READ_TIMEOUT=10s
WRITE_TIMEOUT=15s
IDLE_TIMEOUT=60s
SHUTDOWN_GRACE=20s

# ── Data layer ───────────────────────────────────────────────────────────────
DATABASE_URL=postgres://arena:arena@localhost:5432/arena?sslmode=disable
DB_MAX_CONNS=20
REDIS_URL=redis://localhost:6379/0

# ── HTTP ─────────────────────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ── Auth (used from Stage 1; loaded now so config is complete & fail-fast) ─────
JWT_SIGNING_KEY=dev-only-change-me-32-bytes-minimum!!
API_KEY_PEPPER=dev-only-change-me

# ── Game defaults (used from Stage 3) ──────────────────────────────────────────
MOVE_WINDOW_SECONDS=20
RAKE_PCT=5
DEFAULT_ROUNDS=13

# ── Ratings (Stage 7) ──────────────────────────────────────────────────────────
RATING_K=32
SEASON_LENGTH=720h

# ── Engagement (Stage 8) ───────────────────────────────────────────────────────
CLIP_CDN_BASE=https://cdn.local/clips

# ── Cash-out / withdrawals (coin engine) ───────────────────────────────────────
COIN_CENTS=1                       # face value: 1 coin = 1¢
WITHDRAW_SELL_FEE_PCT=10           # platform cut on withdrawal
STRIPE_PAYOUT_FEE_PCT=0            # Stripe payout fee %, passed to the user
STRIPE_PAYOUT_FEE_FLAT_CENTS=25    # flat Stripe payout fee, passed to the user
WITHDRAW_MIN_COINS=500             # minimum withdrawal
WITHDRAW_CLEARING=24h              # request must age this long before approval

# ── Trust & anti-fraud (Stage 9) ───────────────────────────────────────────────
# Comma-separated user public ids permitted to use admin endpoints.
ADMIN_USER_IDS=
DETECT_INTERVAL=1h
COLLUSION_LOOKBACK=168h
COLLUSION_MIN_GAMES=5

# ── Money & limits (Stage 4) ───────────────────────────────────────────────────
SESSION_WINDOW=6h
RECONCILE_INTERVAL=24h
ALLOW_MINT=true

# ── Payments / Stripe ───────────────────────────────────────────────────────────
# Leave STRIPE_SECRET_KEY empty to use the offline DevGateway (no real charges).
STRIPE_SECRET_KEY=
# Required whenever STRIPE_SECRET_KEY is set. Webhook URL: POST /v1/webhooks/stripe
# Enable: checkout.session.completed, charge.refunded, charge.dispute.created,
# customer.subscription.*, invoice.paid
STRIPE_WEBHOOK_SECRET=
PAYMENTS_RECONCILE_INTERVAL=1h
CHECKOUT_SUCCESS_URL=http://localhost:3000/billing/success
CHECKOUT_CANCEL_URL=http://localhost:3000/billing/cancel
CONNECT_RETURN_URL=http://localhost:3000/payouts/return
CONNECT_REFRESH_URL=http://localhost:3000/payouts/refresh

# ── Arena Pass subscription (Stripe Billing) ───────────────────────────────────
STRIPE_ARENA_PASS_PRICE_ID=
ARENA_PASS_PRICE_CENTS=999
ARENA_PASS_MONTHLY_COINS=1000
SUBSCRIPTION_SUCCESS_URL=http://localhost:3000/subscription/success
SUBSCRIPTION_CANCEL_URL=http://localhost:3000/subscription/cancel
SUBSCRIPTION_PORTAL_URL=http://localhost:3000/subscription

# ── Observability ──────────────────────────────────────────────────────────────
OTEL_EXPORTER_OTLP_ENDPOINT=
