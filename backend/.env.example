# ── Server ───────────────────────────────────────────────────────────────────
ENV=local                 # local | ci | staging | prod
PORT=8080
BASE_URL=http://localhost:8080
LOG_LEVEL=info            # debug | info | warn | error
READ_TIMEOUT=10s
WRITE_TIMEOUT=15s
IDLE_TIMEOUT=60s
SHUTDOWN_GRACE=20s

# ── Data layer ───────────────────────────────────────────────────────────────
DATABASE_URL=postgres://arena:arena@localhost:5432/arena?sslmode=disable
DB_MAX_CONNS=20
REDIS_URL=redis://localhost:6379/0

# ── HTTP ─────────────────────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ── Auth (used from Stage 1; loaded now so config is complete & fail-fast) ─────
JWT_SIGNING_KEY=dev-only-change-me-32-bytes-minimum!!
API_KEY_PEPPER=dev-only-change-me

# ── Game defaults (used from Stage 3) ──────────────────────────────────────────
MOVE_WINDOW_SECONDS=20
RAKE_PCT=5
DEFAULT_ROUNDS=13

# ── Database migrations ────────────────────────────────────────────────────────
# Apply pending migrations in-process on startup (embedded, advisory-locked, safe
# for multiple instances). Set false to manage migrations out-of-band.
AUTO_MIGRATE=true

# ── Sandbox practice mode ──────────────────────────────────────────────────────
# Risk-free matches vs the seeded house agents (no coins, limits, or rating).
SANDBOX_ENABLED=true

# ── Agent manifest / endpoint verification ─────────────────────────────────────
# Permit http:// and private/loopback endpoint hosts in manifests + disable the
# SSRF IP guard. DEV ONLY — lets you verify a manifest pointing at a local starter
# agent. MUST be false in prod (the spec mandates HTTPS; the guard blocks
# loopback/private/link-local/metadata IPs).
AGENT_VERIFY_ALLOW_PRIVATE=false
# Outbound verification client tuning (calls to developer /health and /handshake).
AGENT_VERIFY_TIMEOUT=5s
AGENT_VERIFY_MAX_TIMEOUT=15s
AGENT_VERIFY_RETRIES=2
AGENT_VERIFY_MAX_BODY_BYTES=65536
# Key that encrypts the endpoint bearer token at rest (AES-256-GCM). If unset,
# falls back to API_KEY_PEPPER. Set a strong dedicated secret in prod.
AGENT_ENDPOINT_SECRET_KEY=

# ── Ratings (Stage 7) ──────────────────────────────────────────────────────────
RATING_K=32
SEASON_LENGTH=720h

# ── Engagement (Stage 8) ───────────────────────────────────────────────────────
CLIP_CDN_BASE=https://cdn.local/clips

# ── Cash-out / withdrawals (coin engine) ───────────────────────────────────────
COIN_CENTS=1                       # face value: 1 coin = 1¢
WITHDRAW_SELL_FEE_PCT=10           # platform cut on withdrawal
STRIPE_PAYOUT_FEE_PCT=0            # Stripe payout fee %, passed to the user
STRIPE_PAYOUT_FEE_FLAT_CENTS=25    # flat Stripe payout fee, passed to the user
WITHDRAW_MIN_COINS=500             # minimum withdrawal
WITHDRAW_CLEARING=24h              # request must age this long before approval

# ── Trust & anti-fraud (Stage 9) ───────────────────────────────────────────────
# Comma-separated user public ids permitted to use admin endpoints.
ADMIN_USER_IDS=
DETECT_INTERVAL=1h
COLLUSION_LOOKBACK=168h
COLLUSION_MIN_GAMES=5

# ── Money & limits (Stage 4) ───────────────────────────────────────────────────
SESSION_WINDOW=6h
RECONCILE_INTERVAL=24h
ALLOW_MINT=true

# ── Payments / Stripe ───────────────────────────────────────────────────────────
# Leave STRIPE_SECRET_KEY empty to use the offline DevGateway (no real charges).
STRIPE_SECRET_KEY=
# Required whenever STRIPE_SECRET_KEY is set. Webhook URL: POST /v1/webhooks/stripe
# Enable: checkout.session.completed, charge.refunded, charge.dispute.created,
# customer.subscription.*, invoice.paid
STRIPE_WEBHOOK_SECRET=
PAYMENTS_RECONCILE_INTERVAL=1h
CHECKOUT_SUCCESS_URL=http://localhost:3000/billing/success
CHECKOUT_CANCEL_URL=http://localhost:3000/billing/cancel
CONNECT_RETURN_URL=http://localhost:3000/payouts/return
CONNECT_REFRESH_URL=http://localhost:3000/payouts/refresh

# ── Arena Pass subscription (Stripe Billing) ───────────────────────────────────
STRIPE_ARENA_PASS_PRICE_ID=
ARENA_PASS_PRICE_CENTS=999
ARENA_PASS_MONTHLY_COINS=1000
SUBSCRIPTION_SUCCESS_URL=http://localhost:3000/subscription/success
SUBSCRIPTION_CANCEL_URL=http://localhost:3000/subscription/cancel
SUBSCRIPTION_PORTAL_URL=http://localhost:3000/subscription

# ── Observability ──────────────────────────────────────────────────────────────
OTEL_EXPORTER_OTLP_ENDPOINT=

# ── Platform bus (cross-service Redis channel with the Super Admin) ─────────────
# Ed25519 keys authenticate messages. The engine SIGNS the events it publishes
# with its private key and VERIFIES config against the Admin's public key. Empty
# => signing/verification disabled (dev/local only). Generate a matched set with:
#   go run ./cmd/platform-bus-keygen
# and set the corresponding PLATFORM_ADMIN_PRIVATE_KEY / PLATFORM_ENGINE_PUBLIC_KEY
# in the Super Admin. See docs/architecture/platform-config-bus.md.
PLATFORM_ENGINE_PRIVATE_KEY=
PLATFORM_ADMIN_PUBLIC_KEY=
