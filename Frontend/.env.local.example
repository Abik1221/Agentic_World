# Base URL of the Agent Arena Go backend (no trailing slash).
NEXT_PUBLIC_API_BASE=http://localhost:8080

# Set to 1 to surface API errors instead of mock fallbacks.
# NEXT_PUBLIC_API_STRICT=1

# Optional: show Admin link in nav when your dashboard token belongs to this user id
# (must match backend ADMIN_USER_IDS). Comma-separated if multiple.
# NEXT_PUBLIC_ADMIN_USER_IDS=usr_...

# Privy login (Beta wallet pipeline). Set your Privy app id to enable the
# "Continue with Google, wallet & more" popup on /login. Unset = the CTA is
# hidden and email/password login is used. Pair with the backend's PRIVY_APP_ID
# + PRIVY_VERIFICATION_KEY (the app id must match on both sides).
# NEXT_PUBLIC_PRIVY_APP_ID=
