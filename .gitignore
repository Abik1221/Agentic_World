# Binaries
/bin/
/server
*.exe

# Env & secrets
.env
.env.local
.env.*
!*.example
*.local

# Go
/vendor/
*.test
*.out
# Coverage REPORTS, named by extension. `coverage.*` was the rule here, and it silently
# excluded internal/rating/coverage.go — a real source file — so a fresh clone did not
# compile while `git status` stayed clean, because ignored files are not reported.
coverage.out
coverage.html
coverage.txt

# Node / JS / TS
node_modules/
dist/
.next/
out/
build/
*.tsbuildinfo
.pnp
.pnp.*
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Python
__pycache__/
*.py[cod]
.pytest_cache/
*.egg-info/
.venv/
venv/

# Tooling
.idea/
.vscode/
.DS_Store
*.pem
.vercel

# Super Admin is its own repo (github.com/Abik1221/Super_Admin), embedded here only
# for API-integration reference — never tracked by this repo.
backend/Super_Admin/

# Pyyol_client is its own repo (github.com/Abik1221/Pyyol_client) — the frontend,
# cloned here only for API-integration work. Never tracked by this repo.
Pyyol_client/

# Separate repo (admin) — cloned in-tree, never tracked here
Super_Admin/

# Local beta test harness (agent + docker db + secrets) — never committed.
# ANCHORED to the repo root. Unanchored, `test/` matched every test directory in the tree,
# so a new file under sdk/js/src/test/ was silently ignored — the existing ones are tracked
# only because they predate the rule. Same trap as `coverage.*`; see the Go section.
/test/

# Local lab binaries (built by the docker loop in NEXT_SESSION_PROMPT.md) — 30MB+ each,
# rebuilt from source on demand and never useful in a commit.
backend/.lab-server
backend/.lab-gamelab
# Stray output from `go build ./cmd/gamelab` with no -o. The lab binaries the docker
# workflow uses are backend/.lab-server and backend/.lab-gamelab.
backend/gamelab

# Lens lab binaries, swapped into the processor container to verify a fix without
# rebuilding the image. Same reasoning as the arena ones above: 10MB+ each, built from
# the source beside them.
tracing/backend/.processor
tracing/backend/.backfill

# Compose overrides are per-machine by definition — this one only drops host port
# publishes that another project on that machine already owns. Committing it would
# impose one developer's port conflicts on everyone.
tracing/docker-compose.override.yml
