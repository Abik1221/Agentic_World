# Copy to .env next to docker-compose.yml (docker compose loads it automatically)

INGEST_API_KEY=change-me-in-production
PYYOL_LENS_ADMIN_KEY=

# Web panel (telemetery.pyyol.et via nginx → host :3100)
PYYOL_API_URL=https://api.pyyol.et
PYYOL_LENS_QUERY_URL=http://query-api:8082
PYYOL_LENS_CONTROL_URL=http://control-api:8083
PYYOL_LENS_ALLOW_DIRECT_FALLBACK=false
PYYOL_LENS_DEFAULT_ORG_ID=local-dev-org
PYYOL_LENS_DEFAULT_USER_ID=local-dev-user

# Dashboard login (Pyyol Lens web). Set a password to require sign-in; leave
# unset to run open (dev / behind VPN). SESSION_SECRET signs session cookies.
PYYOL_LENS_AUTH_USER=admin
PYYOL_LENS_AUTH_PASSWORD=
PYYOL_LENS_SESSION_SECRET=
