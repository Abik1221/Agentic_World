SERVICE_NAME=pyyol-lens
PYYOL_LENS_ENV=development

PORT_INGEST=8081
PORT_QUERY=8082
PORT_CONTROL=8083

CH_ADDR=localhost:9000
CH_DB=pyyol_lens
CH_USER=default
CH_PASS=
CH_SECURE=false

PG_ADDR=localhost:5432
PG_USER=pyyol_lens
PG_PASS=pyyol_lens
PG_DB=pyyol_lens

NATS_URL=nats://localhost:4222
NATS_STREAM_NAME=PL_EVENTS
NATS_SUBJECT_EVENTS=pyyol.lens.events
NATS_CONSUMER_NAME=pl-processor

OBJECT_STORE_ENDPOINT=localhost:9001
OBJECT_STORE_BUCKET=pyyol-lens
OBJECT_STORE_KEY=minioadmin
OBJECT_STORE_SECRET=minioadmin
OBJECT_STORE_SSL=false

INGEST_API_KEY=local-pyyol-lens-key
DEFAULT_PROJECT=pyyol-core
RETENTION_DAYS=30
MAX_BATCH_SIZE=500
MAX_EVENTS_PER_READ=500
