# Copy to deploy/.env.trace and fill in. Consumed by docker-compose.trace.yml.
# Do NOT commit the real file (add deploy/.env.trace to .gitignore).

# Dashboard login for the public trace.pyyol.com subdomain (required).
PYYOL_LENS_AUTH_USER=admin
PYYOL_LENS_AUTH_PASSWORD=change-me-strong
# Signs the session cookie — use a long random value (e.g. `openssl rand -hex 32`).
PYYOL_LENS_SESSION_SECRET=change-me-random-hex

# Where the web UI reads traces/control from (compose-internal defaults are fine).
# PYYOL_LENS_QUERY_URL=http://query-api:8082
# PYYOL_LENS_CONTROL_URL=http://control-api:8083
